{
        "version": "0.2.0",
        "configurations": [

                {
                        "type": "probe-rs-debug",
                        "request": "launch",
                        "name": "probe-rs",
                        "cwd": "${workspaceFolder}",
                        "connectUnderReset": false,
                        "chip": "STM32U545RETx",
                        "flashingConfig": {
                                "flashingEnabled": true,
                                "verifyBeforeFlashing": true,
                                "verifyAfterFlashing": true,
                                "haltAfterReset": true
                        },
                        "coreConfigs": [
                                {
                                        "coreIndex": 0,
                                        "programBinary": "./build/zephyr/zephyr.elf"
                                }
                        ]
                }
        ]
}